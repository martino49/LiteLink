<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mirrorToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card"
        app:title="Screen Mirror"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/mirrorStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not connected"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/muted"
                android:background="@drawable/bg_pill"
                android:paddingVertical="10dp"
                android:paddingHorizontal="16dp"
                android:gravity="center" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ink"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:gravity="center"
                    android:text="The phone screen opens on your PC\nin its own scrcpy window."
                    android:textSize="14sp"
                    android:textColor="@color/muted"
                    android:textAlignment="center" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mirrorStartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Start mirroring"
                app:icon="@drawable/ic_compass"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mirrorStopButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Stop mirroring"
                app:icon="@drawable/ic_close"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  TOUCHPAD  "
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/teal_700"
                android:letterSpacing="0.12"
                android:background="@color/pill_grey"
                android:padding="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mirrorTouchpadButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open touchpad"
                app:icon="@drawable/ic_compass"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tip: the mirror runs on your PC. Use the touchpad to move the cursor there."
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:layout_marginTop="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
