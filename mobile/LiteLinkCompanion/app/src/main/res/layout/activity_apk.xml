<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/apkToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card"
        app:title="APK Installer"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/ink" />

    <TextView
        android:id="@+id/apkPendingCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 APKs pending"
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp" />

    <TextView
        android:id="@+id/apkEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No pending APKs. APKs sent from the desktop appear here."
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/apkList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apkInstallAllButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Install all"
            app:icon="@drawable/ic_download"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apkClearButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Clear"
            app:icon="@drawable/ic_trash"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apkHistoryButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="History"
            app:icon="@drawable/ic_info"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
