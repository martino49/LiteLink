<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mediaToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card"
        app:title="Media Controller"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/ink" />

    <TextView
        android:id="@+id/mediaStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Controls media playing on your PC."
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:padding="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/mediaPrev"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_previous"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/mediaPlayPause"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/mediaNext"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_next"
            android:contentDescription="Next" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mediaVolDown"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vol −"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mediaMute"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Mute"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mediaVolUp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Vol +"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/mediaNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Works with YouTube, Spotify, VLC, WMP and anything using standard media keys."
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:padding="16dp"
        android:layout_marginTop="16dp" />
</LinearLayout>
