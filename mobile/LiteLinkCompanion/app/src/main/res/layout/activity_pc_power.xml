<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/powerToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card"
        app:title="PC Power"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/ink" />

    <TextView
        android:id="@+id/powerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Control your PC's power state."
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:padding="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/powerShutdown"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shutdown"
            app:icon="@drawable/ic_close"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/powerRestart"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Restart"
            app:icon="@drawable/ic_refresh"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/powerSleep"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sleep"
            app:icon="@drawable/ic_power"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/powerLock"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Lock"
            app:icon="@drawable/ic_ring"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shutdown and Restart ask for confirmation."
        android:textSize="12sp"
        android:textColor="@color/muted"
        android:padding="16dp"
        android:layout_marginTop="16dp" />
</LinearLayout>
