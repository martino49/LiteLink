<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Pull tab handle -->
            <View
                android:id="@+id/pullHandle"
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill" />

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/litelink_logo"
                android:contentDescription="LiteLink logo"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="LiteLink"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/teal_700" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Finding your PC…"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:layout_marginBottom="12dp" />

            <!-- Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/pill_grey"
                android:padding="12dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/status_dot"
                    android:backgroundTint="@color/muted" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Searching for your PC on this network…"
                    android:textSize="14sp"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <!-- Discovered devices -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  YOUR PCS  "
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/teal_700"
                android:letterSpacing="0.12"
                android:background="@color/pill_grey"
                android:padding="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/discoveredList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:paddingHorizontal="2dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <TextView
                android:id="@+id/discoveredEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Searching for your PC…"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:gravity="center"
                android:padding="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan again"
                app:icon="@drawable/ic_refresh"
                android:textSize="13sp" />

            <!-- Recents -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  RECENT PCS  "
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/teal_700"
                android:letterSpacing="0.12"
                android:background="@color/pill_grey"
                android:padding="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/recentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LiteLink v1.0  ·  Wi-Fi only"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:gravity="center"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/featuresFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="All features"
        android:src="@drawable/ic_compass"
        app:backgroundTint="@color/teal_700"
        app:tint="@color/card" />

</FrameLayout>
